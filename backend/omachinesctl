#!/usr/bin/env python3
"""Omachines CLI and one-per-shell JSON line service."""
import argparse
import concurrent.futures
import json
import os
from pathlib import Path
import selectors
import sys
import time

sys.dont_write_bytecode = True
sys.path.insert(0,str(Path(__file__).resolve().parent))
from core import OperationError, collect, now, operation, settings, state_dir, write_json
from operations import ACTIONS, request_action, worker


def emit(value):
    print(json.dumps(value,ensure_ascii=False,separators=(",",":")),flush=True)


def daemon():
    config=settings()
    selector=selectors.DefaultSelector()
    selector.register(sys.stdin,selectors.EVENT_READ)
    pool=concurrent.futures.ThreadPoolExecutor(max_workers=1)
    snapshot={"state":"checking","summary":"Checking Windows","checks":{},"resources":{},"backups":[],"operation":{},"capabilities":{}}
    pending=None
    due=0
    deep_due=0
    requested=False
    buffer=b""
    emit(snapshot)
    try:
        while True:
            clock=time.monotonic()
            if pending and pending.done():
                try:
                    snapshot=pending.result()
                    snapshot["error"]=""
                except Exception:
                    snapshot={**snapshot,"error":"Connection check failed; previous results may be stale"}
                pending=None
                emit(snapshot)
            if not pending and (requested or clock>=due):
                deep=(requested or clock>=deep_due) and snapshot.get("operation",{}).get("status") not in ("starting","running")
                pending=pool.submit(collect,dict(config),deep,dict(snapshot))
                requested=False
                due=clock+15
                if deep:
                    deep_due=clock+config["pollSeconds"]
            op=operation() if not config["demo"] else {}
            if op!=snapshot.get("operation",{}):
                snapshot["operation"]=op
                emit(snapshot)
                if op.get("status") in ("complete","failed"):
                    requested=True
            if not selector.select(1):
                continue
            chunk=os.read(sys.stdin.fileno(),65536)
            if not chunk:
                return
            buffer+=chunk
            if len(buffer)>65536:
                buffer=b""
                continue
            while b"\n" in buffer:
                line,buffer=buffer.split(b"\n",1)
                try:
                    command=json.loads(line)
                    verb=command.get("cmd")
                    if verb=="configure":
                        new=settings(command.get("settings",{}))
                        if new!=config:
                            config=new
                            requested=True
                    elif verb=="refresh":
                        requested=True
                    elif verb=="action":
                        request_action(command.get("action"),config,command.get("confirmed") is True)
                    else:
                        raise OperationError("Unknown command")
                except Exception as error:
                    snapshot["error"]=str(error) if isinstance(error,OperationError) else "Invalid request"
                    emit(snapshot)
    finally:
        selector.close()
        pool.shutdown(wait=False,cancel_futures=True)


def main():
    parser=argparse.ArgumentParser(description=__doc__)
    sub=parser.add_subparsers(dest="command",required=True)
    sub.add_parser("daemon")
    status=sub.add_parser("status")
    status.add_argument("--deep",action="store_true")
    status.add_argument("--demo",action="store_true")
    action=sub.add_parser("action")
    action.add_argument("action",choices=sorted(ACTIONS))
    action.add_argument("--confirm",action="store_true")
    work=sub.add_parser("worker")
    work.add_argument("action",choices=sorted(ACTIONS))
    work.add_argument("--interactive",action="store_true")
    args=parser.parse_args()
    if args.command=="daemon":
        daemon()
    elif args.command=="status":
        emit(collect(settings({"demo":args.demo}),deep=args.deep))
    elif args.command=="action":
        request_action(args.action,settings(),args.confirm)
    elif args.command=="worker":
        return worker(args.action,args.interactive)
    return 0


if __name__=="__main__":
    try:
        sys.exit(main())
    except (OperationError,OSError):
        print("Omachines could not complete the request. Check its panel or operation terminal.",file=sys.stderr)
        sys.exit(1)
